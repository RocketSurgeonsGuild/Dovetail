<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <ProjectReference Include="..\..\src\Joinery.Dovetail\Joinery.Dovetail.csproj" />
        <ProjectReference
            Include="..\..\src\Joinery.Dovetail.Analyzers\Joinery.Dovetail.Analyzers.csproj"
            IncludeAssets="all"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
        />
        <DovetailJoint Include="DatabaseConfigurator" Namespace="Joinery.Dovetail.Joints" ParameterType="Sample.Core.Databases.IDatabaseConfigurator" ParameterName="builder" />
    </ItemGroup>

    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <!-- Sample.BlazorWasm builds this for browser-wasm (see RuntimeAsyncBrowserWasmAsset in the root Directory.Build.targets). -->
        <RuntimeAsyncBrowserWasmAsset>true</RuntimeAsyncBrowserWasmAsset>
    </PropertyGroup>
</Project>
