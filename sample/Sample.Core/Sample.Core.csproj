<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <ProjectReference Include="..\..\src\Dovetail\Dovetail.csproj" />
        <ProjectReference
            Include="..\..\src\Dovetail.Analyzers\Dovetail.Analyzers.csproj"
            IncludeAssets="all"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
        />
        <DovetailJoint Include="DatabaseConfigurator" Namespace="Dovetail.Joints" ParameterType="Sample.Core.Databases.IDatabaseConfigurator" ParameterName="builder" />
    </ItemGroup>

    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <!-- Sample.BlazorWasm loads the net11.0 build, and Mono can't run runtime-async methods. -->
        <UseRuntimeAsync>false</UseRuntimeAsync>
    </PropertyGroup>
</Project>
