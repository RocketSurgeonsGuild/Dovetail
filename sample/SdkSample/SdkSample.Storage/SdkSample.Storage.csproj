<!--
    A plain class library, like SdkSample.Greetings. Both options types here are immutable (a positional record, and a class
    with required and init-only members), so Dovetail binds them through generated create code instead of the options
    pipeline's parameterless constructor.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Joinery.Dovetail.Sdk" Version="0.0.0-sample" />
  <ItemGroup>
    <!-- Binds the [Optionary] options types and writes their schema; Dovetail's joint registers them. -->
    <PackageReference Include="Optionary" Version="0.1.2" />
  </ItemGroup>
</Project>
