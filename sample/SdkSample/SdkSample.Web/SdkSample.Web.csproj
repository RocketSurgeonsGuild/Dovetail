<!--
    Microsoft.NET.Sdk.Web makes Joinery.Dovetail.Sdk detect a WebApplicationBuilder host: it injects
    Joinery.Dovetail.Hosting and generates the ConfigureDovetail() extension used in Program.cs.
-->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <Sdk Name="Joinery.Dovetail.Sdk" Version="0.0.0-sample" />
  <PropertyGroup>
    <!--
        Serves the merged configuration schema at /.well-known/dovetail/configuration-schema, only while developing: the
        schema describes every setting the application reads, so it isn't something to expose by default.
    -->
    <DovetailConfigurationSchemaEndpoint>true</DovetailConfigurationSchemaEndpoint>
    <DovetailConfigurationSchemaEndpointEnvironments>Development</DovetailConfigurationSchemaEndpointEnvironments>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SdkSample.Greetings\SdkSample.Greetings.csproj" />
    <ProjectReference Include="..\SdkSample.Notifications\SdkSample.Notifications.csproj" />
    <ProjectReference Include="..\SdkSample.Storage\SdkSample.Storage.csproj" />
    <ProjectReference Include="..\SdkSample.Diagnostics\SdkSample.Diagnostics.csproj" />
  </ItemGroup>
</Project>
