<!--
    OutputType=Exe makes Joinery.Dovetail.Sdk detect a HostApplicationBuilder host: it injects
    Joinery.Dovetail.Hosting, which generates the ConfigureDovetail() extension used in Program.cs
    once the project references Microsoft.Extensions.Hosting (the generic host) itself.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Joinery.Dovetail.Sdk" Version="0.4.1" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <ProjectReference Include="..\SdkSample.Greetings\SdkSample.Greetings.csproj" />
    <ProjectReference Include="..\SdkSample.Notifications\SdkSample.Notifications.csproj" />
    <ProjectReference Include="..\SdkSample.Storage\SdkSample.Storage.csproj" />
    <ProjectReference Include="..\SdkSample.Diagnostics\SdkSample.Diagnostics.csproj" />
  </ItemGroup>
</Project>
