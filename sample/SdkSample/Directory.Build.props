<!--
    Settings every project here shares. The Dovetail wiring is in each project: an
    <Sdk Name="Joinery.Dovetail.Sdk" Version="..." /> element next to its own SDK, which is enough for it to pick up the
    right Dovetail packages and generated bootstrapping for its host type. No project references Dovetail directly.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Opt in to managed configuration: injects Joinery.Dovetail.Configuration.Yaml (YAML is the default format). -->
    <DovetailEnableConfiguration>true</DovetailEnableConfiguration>
  </PropertyGroup>
</Project>
