<!--
    A plain class library, like SdkSample.Greetings: Joinery.Dovetail.Sdk injects the Dovetail package, exports this assembly's
    [DovetailExport] joints and renames appsettings.yaml to SdkSample.Notifications.yaml.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Joinery.Dovetail.Sdk" Version="0.0.0-sample" />
  <ItemGroup>
    <!-- Binds the [Optionary] options types and writes their schema; Dovetail's joint registers them. -->
    <PackageReference Include="Optionary" Version="0.1.1-beta.0" />
  </ItemGroup>
</Project>
