<?xml version="1.0" encoding="utf-8" ?>
<!--
    Self-contained on purpose: <clear /> drops the repository's own NuGet.config so this sample
    resolves packages the same way an external consumer would - Dovetail.* from the locally packed
    feed (see build/pack.proj), everything else from nuget.org.
-->
<configuration>
    <config>
        <!--
            Packages are always packed at the same fixed version (0.0.0-sample), so a shared
            ~/.nuget/packages cache would keep serving the first copy ever restored. Instead,
            build/pack.proj clears the Dovetail entries from this sample-local cache on every pack.
        -->
        <add key="globalPackagesFolder" value=".nuget/packages" />
    </config>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <add key="dovetail-sample" value="../../artifacts/nuget-sample" />
    </packageSources>
    <packageSourceMapping>
        <clear />
        <packageSource key="dovetail-sample">
            <package pattern="Dovetail" />
            <package pattern="Dovetail.*" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
