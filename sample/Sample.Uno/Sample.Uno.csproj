<Project Sdk="Uno.Sdk/6.7.30">
  <!--
      An Uno Platform app (Uno.Extensions.Hosting) bootstrapped by Dovetail (see App.xaml.cs), on the stable Uno.Sdk and the
      net10.0 heads. Its app code is shared with Sample.Uno.Net11. Needs the Uno Platform workloads for the mobile/Windows heads,
      so Dovetail.slnx doesn't build it by default; the workload-samples workflow builds it per platform.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0-browserwasm;net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.26100</TargetFrameworks>
    <!-- Lets a build (e.g. one CI leg) pick the heads it has workloads for, without the property flowing to referenced projects. A list arrives escaped (';' as %3B) from the command line. -->
    <TargetFrameworks Condition="'$(DovetailSampleTargetFrameworks)' != ''">$([MSBuild]::Unescape('$(DovetailSampleTargetFrameworks)'))</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <ApplicationTitle>Dovetail Uno Sample</ApplicationTitle>
    <ApplicationId>com.rocketsurgeonsguild.dovetail.sample.uno</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>Rocket Surgeons Guild</ApplicationPublisher>
    <Description>Dovetail on Uno Platform.</Description>
    <UnoFeatures>
      Hosting;
      Logging;
      Configuration;
      SkiaRenderer;
    </UnoFeatures>
    <!-- NU1507: multiple package sources with CPM; NETSDK1201: RID without self-contained; PRI257: default language not in resources. -->
    <NoWarn>$(NoWarn);NU1507;NETSDK1201;PRI257</NoWarn>
    <!-- Uno.Sdk's implicit Microsoft.Extensions.Logging packages, aligned with the repo's Microsoft.Extensions pins (Directory.Packages.props). -->
    <MicrosoftLoggingVersion>10.0.13</MicrosoftLoggingVersion>

    <!-- What the Dovetail SDK's Uno detection sets (see src/Dovetail.Sdk/Sdk/Dovetail.HostDetection.targets); samples reference src directly. -->
    <DovetailEmbedConfiguration>true</DovetailEmbedConfiguration>
    <!--
        The repo's Rocket.Surgery.MSBuild.SourceLink turns these on; with the Skia renderer, Uno swaps in its own runtime
        assemblies and their .pdb/.xml, so the package copies would land in the output twice (NETSDK1152, and a duplicate key in
        the WebAssembly boot manifest).
    -->
    <CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
    <CopyDocumentationFilesFromPackages>false</CopyDocumentationFilesFromPackages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dovetail.Hosting.Uno\Dovetail.Hosting.Uno.csproj" />
    <ProjectReference Include="..\..\src\Dovetail.Configuration.Json\Dovetail.Configuration.Json.csproj" />

    <DovetailHost
      Include="Uno"
      HostBuilderType="global::Uno.Extensions.Hosting.IApplicationBuilder"
      HostBuilderName="builder"
      HostType="global::Microsoft.Extensions.Hosting.IHost"
      HelperName="global::Dovetail.DovetailUnoHelpers"
      BuildExpression=", static b => b.Build(), typeof(GeneratedDovetailUnoExtensions).Assembly"
      NavigateEntryPoint="true"
    />
  </ItemGroup>
  <!--
    The libraries' net11.0 builds declare RuntimeIdentifiers (browser-wasm, for runtime async), so the app's per-RID head
    builds would pass their RuntimeIdentifier down to them - including the transitive references the SDK adds, hence an item
    definition rather than metadata on the references below. Package consumers don't see this: the libraries ship RID-agnostic.
  -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <GlobalPropertiesToRemove>%(GlobalPropertiesToRemove);RuntimeIdentifier;SelfContained</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemDefinitionGroup>
</Project>
