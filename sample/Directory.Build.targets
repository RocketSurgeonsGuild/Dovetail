<Project>
  <Import Project="$(MSBuildThisFileDirectory)../src/Joinery.Dovetail/build/Joinery.Dovetail.targets" />
  <Import Project="$(MSBuildThisFileDirectory)../src/Joinery.Dovetail.Hosting/build/Joinery.Dovetail.Hosting.targets" />
  <Import Project="$(MSBuildThisFileDirectory)../src/Joinery.Dovetail.Build.Tasks/Joinery.Dovetail.Build.Tasks.InRepo.targets" />
  <ItemGroup>
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)../src/Joinery.Dovetail.Analyzers/Joinery.Dovetail.Analyzers.csproj"
      IncludeAssets="all"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      IsAspireProjectResource="false"
    />
  </ItemGroup>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />
  <Import Project="$(MSBuildThisFileDirectory)../src/Joinery.Dovetail.Configuration.Yaml/build/Joinery.Dovetail.Configuration.Yaml.targets" />
  <Import Project="$(MSBuildThisFileDirectory)../src/Joinery.Dovetail.Configuration.Json/build/Joinery.Dovetail.Configuration.Json.targets" />
</Project>
