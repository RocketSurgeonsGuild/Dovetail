<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Sample.DependencyOne\Sample.DependencyOne.csproj" PrivateAssets="none" />
    </ItemGroup>
    <!-- Used to simulate anaylzer getting added by package reference -->
    <ItemGroup>
        <Analyzer
            Include="$([System.IO.Path]::GetFullPath($(MSBuildThisFileDirectory)\..\..))\src\Joinery.Dovetail.Analyzers\bin\$(Configuration)\netstandard2.0\Joinery.Dovetail.Analyzers.dll"
            Condition="'$(Language)'=='C#'"
        />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\Joinery.Dovetail\Joinery.Dovetail.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FluentValidation" />
    </ItemGroup>
</Project>
