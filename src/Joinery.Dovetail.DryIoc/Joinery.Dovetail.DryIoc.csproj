<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <RuntimeAsyncBrowserWasmAsset>true</RuntimeAsyncBrowserWasmAsset>
        <PackageDescription>Provides DryIoc support for a Rocket Surgery Application</PackageDescription>
        <PackageTags>$(PackageTags);DryIoc</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <DovetailJoint Include="DryIoc" Namespace="Joinery.Dovetail.Joints" ParameterType="global::DryIoc.IContainer" ParameterName="container" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Joinery.Dovetail\Joinery.Dovetail.csproj" />
        <PackageReference Include="DryIoc.Microsoft.DependencyInjection" />
        <InternalsVisibleTo Include="Rocket.Surgery.Extensions.DryIoc.Tests" />
    </ItemGroup>
</Project>
