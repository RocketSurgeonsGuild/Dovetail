<Project>

  <!--
    Imported only when configuration is enabled (see Dovetail.HostDetection.targets). YAML is the default
    format, but only when no other format was chosen explicitly - opting into JSON or TOML alone shouldn't
    also pull in the YAML provider. YAML is then left unset rather than 'false', because
    Dovetail.PackConfiguration.targets treats an explicit 'false' as a veto on its generated YAML joint.
  -->
  <PropertyGroup>
    <DovetailEnableYamlConfiguration Condition="'$(DovetailEnableYamlConfiguration)' == '' and '$(DovetailEnableJsonConfiguration)' != 'true' and '$(DovetailEnableTomlConfiguration)' != 'true'">true</DovetailEnableYamlConfiguration>
    <DovetailEnableJsonConfiguration Condition="'$(DovetailEnableJsonConfiguration)' == ''">false</DovetailEnableJsonConfiguration>
    <DovetailEnableTomlConfiguration Condition="'$(DovetailEnableTomlConfiguration)' == ''">false</DovetailEnableTomlConfiguration>
  </PropertyGroup>

  <ItemGroup Condition="'$(DovetailEnableConfiguration)' == 'true'">
    <DovetailSdkImplicitPackageReference Include="Joinery.Dovetail.Configuration.Json" Version="$(DovetailConfigurationJsonVersion)" Condition="'$(DovetailEnableJsonConfiguration)' == 'true'"/>
    <DovetailSdkImplicitPackageReference Include="Joinery.Dovetail.Configuration.Yaml" Version="$(DovetailConfigurationYamlVersion)" Condition="'$(DovetailEnableYamlConfiguration)' == 'true'"/>
    <DovetailSdkImplicitPackageReference Include="Joinery.Dovetail.Configuration.Toml" Version="$(DovetailConfigurationTomlVersion)" Condition="'$(DovetailEnableTomlConfiguration)' == 'true'"/>
  </ItemGroup>

  <!--
    .gitignore warning (task 1.6): appsettings.local.{ext} is a developer-machine-only
    override layer (design.md Decision 8) and must never be committed. Warn instead of
    writing to the project's .gitignore, so the developer stays in control of that file.

    Git applies every .gitignore between a file and the repository root, so an entry in a parent
    directory (typically the repository root) counts too. Walks up through at most four .gitignore
    files - each hop only happens when another .gitignore exists further up, which covers the usual
    project/solution/repository layouts without an inline task compiled on every build.
  -->
  <Target Name="_DovetailScaffoldLocalConfigurationGitIgnore"
          Condition="'$(DovetailEnableConfiguration)' == 'true'"
          BeforeTargets="Build;Restore">
    <PropertyGroup>
      <_DovetailGitIgnoreEntry>appsettings.local.</_DovetailGitIgnoreEntry>

      <_DovetailGitIgnore1>$([MSBuild]::GetPathOfFileAbove('.gitignore', '$(MSBuildProjectDirectory)'))</_DovetailGitIgnore1>
      <_DovetailGitIgnoreFound Condition="'$(_DovetailGitIgnore1)' != '' and $([System.IO.File]::ReadAllText('$(_DovetailGitIgnore1)').Contains('$(_DovetailGitIgnoreEntry)'))">true</_DovetailGitIgnoreFound>
      <_DovetailGitIgnoreParent1 Condition="'$(_DovetailGitIgnore1)' != ''">$([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName('$(_DovetailGitIgnore1)'))))</_DovetailGitIgnoreParent1>

      <_DovetailGitIgnore2 Condition="'$(_DovetailGitIgnoreFound)' != 'true' and '$(_DovetailGitIgnoreParent1)' != ''">$([MSBuild]::GetPathOfFileAbove('.gitignore', '$(_DovetailGitIgnoreParent1)'))</_DovetailGitIgnore2>
      <_DovetailGitIgnoreFound Condition="'$(_DovetailGitIgnore2)' != '' and $([System.IO.File]::ReadAllText('$(_DovetailGitIgnore2)').Contains('$(_DovetailGitIgnoreEntry)'))">true</_DovetailGitIgnoreFound>
      <_DovetailGitIgnoreParent2 Condition="'$(_DovetailGitIgnore2)' != ''">$([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName('$(_DovetailGitIgnore2)'))))</_DovetailGitIgnoreParent2>

      <_DovetailGitIgnore3 Condition="'$(_DovetailGitIgnoreFound)' != 'true' and '$(_DovetailGitIgnoreParent2)' != ''">$([MSBuild]::GetPathOfFileAbove('.gitignore', '$(_DovetailGitIgnoreParent2)'))</_DovetailGitIgnore3>
      <_DovetailGitIgnoreFound Condition="'$(_DovetailGitIgnore3)' != '' and $([System.IO.File]::ReadAllText('$(_DovetailGitIgnore3)').Contains('$(_DovetailGitIgnoreEntry)'))">true</_DovetailGitIgnoreFound>
      <_DovetailGitIgnoreParent3 Condition="'$(_DovetailGitIgnore3)' != ''">$([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName('$(_DovetailGitIgnore3)'))))</_DovetailGitIgnoreParent3>

      <_DovetailGitIgnore4 Condition="'$(_DovetailGitIgnoreFound)' != 'true' and '$(_DovetailGitIgnoreParent3)' != ''">$([MSBuild]::GetPathOfFileAbove('.gitignore', '$(_DovetailGitIgnoreParent3)'))</_DovetailGitIgnore4>
      <_DovetailGitIgnoreFound Condition="'$(_DovetailGitIgnore4)' != '' and $([System.IO.File]::ReadAllText('$(_DovetailGitIgnore4)').Contains('$(_DovetailGitIgnoreEntry)'))">true</_DovetailGitIgnoreFound>
    </PropertyGroup>
    <Warning
      Text="DovetailConfiguration: no .gitignore at or above '$(MSBuildProjectDirectory)' appears to ignore appsettings.local.{json,yaml,yml,toml}. Add those patterns to your .gitignore so local-only configuration overrides are never committed."
      Condition="'$(_DovetailGitIgnoreFound)' != 'true'"/>
  </Target>
</Project>
