<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
    <PropertyGroup>
        <_Analyzer_Roslyn_Version_>$(MSBuildProjectName.Replace('Joinery.Dovetail.Analyzers.', ''))</_Analyzer_Roslyn_Version_>
        <DefineConstants>$(DefineConstants);$(_Analyzer_Roslyn_Version_.Replace('.', '_').ToUpper())</DefineConstants>
        <BaseOutputPath>bin/$(_Analyzer_Roslyn_Version_)/</BaseOutputPath>
        <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj/$(_Analyzer_Roslyn_Version_)/</BaseIntermediateOutputPath>
        <NoWarn>NU5105;$(NoWarn)</NoWarn>
        <RootNamespace>Joinery.Dovetail.Analyzers</RootNamespace>
        <AssemblyName>Joinery.Dovetail.Analyzers</AssemblyName>
        <IsPackable>false</IsPackable>
        <NoPackageAnalysis>true</NoPackageAnalysis>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <TargetFramework>netstandard2.0</TargetFramework>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <GenerateAssemblyInfoManifest>false</GenerateAssemblyInfoManifest>
        <!-- The generator only reads its own constants; the dependency accessors load assemblies, which analyzers may not. -->
        <AssemblyInfoDependencies>false</AssemblyInfoDependencies>
        <!-- The namespace the Joinery.Dovetail.Analyzers project (RootNamespace Joinery.Dovetail) generates AssemblyInfo in, for the shared sources. -->
        <AssemblyInfoNamespace>Joinery.Dovetail</AssemblyInfoNamespace>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    </PropertyGroup>
</Project>
