<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <RuntimeAsyncBrowserWasmAsset>true</RuntimeAsyncBrowserWasmAsset>
        <PackageDescription>Provides Autofac support for a Rocket Surgery Application</PackageDescription>
        <PackageTags>$(PackageTags);autofac</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <DovetailJoint Include="Autofac" Namespace="Joinery.Dovetail.Joints" ParameterType="global::Autofac.ContainerBuilder" ParameterName="builder" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Joinery.Dovetail\Joinery.Dovetail.csproj" />
        <PackageReference Include="Autofac.Extensions.DependencyInjection" />
        <InternalsVisibleTo Include="Rocket.Surgery.Extensions.Autofac.Tests" />
    </ItemGroup>
</Project>
