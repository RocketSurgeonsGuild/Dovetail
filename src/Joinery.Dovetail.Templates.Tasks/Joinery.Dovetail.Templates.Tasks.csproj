<Project Sdk="Microsoft.NET.Sdk">
  <!--
      The MSBuild task that writes DovetailTemplate items (build/Joinery.Dovetail.Templates.targets). Like Joinery.Dovetail.Build.Tasks
      it ships inside the Dovetail package (build/tasks/netstandard2.0, see Joinery.Dovetail.csproj) rather than as a package of its own.
      A separate assembly because every project that emits a template runs it, while Joinery.Dovetail.Build.Tasks belongs to the
      configuration schema (and is built only where DovetailConfigurationSchema is on); this one needs nothing but MSBuild.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Joinery.Dovetail.Templates.Tasks</RootNamespace>
  </PropertyGroup>
  <!-- Compile-only references: whatever MSBuild runs the task provides these assemblies, so none are copied or packed. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- netstandard2.0 has no NotNullAttribute, and a polyfilled one would clash with the real one in the tests. -->
    <Using Remove="System.Diagnostics.CodeAnalysis.NotNullAttribute" />
  </ItemGroup>
</Project>
