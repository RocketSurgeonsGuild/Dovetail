<Project>
  <!--
      In-repo builds (src, test, sample and benchmarks import this from their Directory.Build.targets) write templates with the task
      from this project's output instead of a packed Dovetail: Joinery.Dovetail.Templates.targets only registers the packed copy when
      _DovetailTemplatesTasksAssembly is empty. TaskHostFactory runs each call in a short-lived task host, so no long-lived MSBuild
      node keeps (and locks) an old copy of the DLL while it is rebuilt.
  -->
  <PropertyGroup>
    <_DovetailTemplatesTasksAssembly>$(MSBuildThisFileDirectory)bin/$(Configuration)/netstandard2.0/Joinery.Dovetail.Templates.Tasks.dll</_DovetailTemplatesTasksAssembly>
  </PropertyGroup>
  <UsingTask TaskName="Joinery.Dovetail.Templates.Tasks.ExpandTemplate" AssemblyFile="$(_DovetailTemplatesTasksAssembly)" TaskFactory="TaskHostFactory" />
  <!--
      Builds the task first, for every project that could emit a template (any project importing Joinery.Dovetail.Templates.targets),
      except the task itself, the generator and the MSBuild SDK packages (DovetailSdkPackage), which run no templates. Not a real
      reference: nothing compiles against it, no package depends on it, and an Aspire AppHost doesn't make it a resource.
      AdditionalProperties is cleared so browser-wasm builds (see the root Directory.Build.targets) don't build it for that runtime,
      into another folder.
  -->
  <ItemGroup
    Condition="'$(MSBuildProjectName)' != 'Joinery.Dovetail.Templates.Tasks' and '$(DovetailSdkPackage)' != 'true' and !$(MSBuildProjectName.StartsWith('Joinery.Dovetail.Analyzers')) and '@(ProjectReference->AnyHaveMetadataValue('Filename', 'Joinery.Dovetail.Templates.Tasks'))' != 'true'"
  >
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)Joinery.Dovetail.Templates.Tasks.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
      AdditionalProperties=""
      IsAspireProjectResource="false" />
  </ItemGroup>
</Project>
