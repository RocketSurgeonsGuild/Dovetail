<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <RuntimeAsyncBrowserWasmAsset>true</RuntimeAsyncBrowserWasmAsset>
        <PackageDescription>Applies Dovetail joints to Aspire's IDistributedApplicationTestingBuilder, so integration tests build the AppHost with the same joints as the application.</PackageDescription>
        <PackageTags>$(PackageTags);aspire;dotnet-aspire;testing;integration-testing</PackageTags>
        <RootNamespace>Joinery.Dovetail.Testing</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Joinery.Dovetail/Joinery.Dovetail.csproj" />
        <ProjectReference Include="../../src/Joinery.Dovetail.Aspire/Joinery.Dovetail.Aspire.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Aspire.Hosting.Tests" />
        <PackageReference Include="Aspire.Hosting.Testing" />
    </ItemGroup>
    <ItemGroup>
        <DovetailJoint
            Include="DistributedApplicationTesting"
            NMAmespace="Joinery.Dovetail.Testing.Joints"
            ParameterType="global::Aspire.Hosting.Testing.IDistributedApplicationTestingBuilder"
            ParameterName="builder"
        />
    </ItemGroup>
</Project>
