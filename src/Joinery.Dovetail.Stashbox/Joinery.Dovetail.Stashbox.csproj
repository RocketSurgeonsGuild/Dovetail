<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <RuntimeAsyncBrowserWasmAsset>true</RuntimeAsyncBrowserWasmAsset>
        <PackageDescription>Uses Stashbox as the application's container and adds a Stashbox joint, so libraries can register services on its IStashboxContainer.</PackageDescription>
        <PackageTags>$(PackageTags);stashbox;dependency-injection;ioc;container</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <DovetailJoint Include="Stashbox" Namespace="Joinery.Dovetail.Joints" ParameterType="global::Stashbox.IStashboxContainer" ParameterName="container" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Joinery.Dovetail\Joinery.Dovetail.csproj" />
        <PackageReference Include="Stashbox.Extensions.DependencyInjection" />
    </ItemGroup>
</Project>
