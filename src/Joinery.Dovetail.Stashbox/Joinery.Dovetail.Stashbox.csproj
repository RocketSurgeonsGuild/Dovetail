<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <RuntimeAsyncBrowserWasmAsset>true</RuntimeAsyncBrowserWasmAsset>
        <PackageDescription>Provides Stashbox support for a Rocket Surgery Application</PackageDescription>
        <PackageTags>$(PackageTags);Stashbox</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <DovetailJoint Include="Stashbox" Namespace="Joinery.Dovetail.Joints" ParameterType="global::Stashbox.IStashboxContainer" ParameterName="container" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Joinery.Dovetail\Joinery.Dovetail.csproj" />
        <PackageReference Include="Stashbox.Extensions.DependencyInjection" />
    </ItemGroup>
</Project>
