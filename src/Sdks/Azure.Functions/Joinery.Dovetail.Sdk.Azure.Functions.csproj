<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The SDK this one mirrors: src/Sdks/Directory.Build.targets writes the package's description and Sdk/Packages.props from it. -->
    <DovetailMicrosoftSdk>Azure.Functions.Sdk</DovetailMicrosoftSdk>
    <!-- Azure.Functions.Sdk comes from NuGet, so Packages.props also pins the version Sdk.props imports it at. -->
    <DovetailMicrosoftSdkVersionProperty>DovetailAzureFunctionsSdkVersion</DovetailMicrosoftSdkVersionProperty>
    <PackageTags>$(PackageTags);azure;azure-functions;functions;dotnet-isolated</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- The isolated worker the SDK adds to every Functions application (see Sdk/Sdk.props), at the version Directory.Packages.props pins. -->
    <DovetailMirrorPackage Include="Microsoft.Azure.Functions.Worker" Property="DovetailAzureFunctionsWorkerVersion" />
  </ItemGroup>
</Project>
