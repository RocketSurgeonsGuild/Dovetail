<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
        The SDK this one mirrors: src/Sdks/Directory.Build.targets writes Sdk/Packages.props from it. Since Aspire 17 a C# AppHost is
        Microsoft.NET.Sdk with the Aspire.Hosting.AppHost and Aspire.Hosting.Dotnet packages (Aspire.AppHost.Sdk is obsolete, ASPIRE012).
    -->
    <DovetailMicrosoftSdk>Microsoft.NET.Sdk</DovetailMicrosoftSdk>
    <PackageDescription>Aspire AppHost projects (Microsoft.NET.Sdk with Aspire.Hosting.AppHost and Aspire.Hosting.Dotnet) with Dovetail: a drop-in replacement for the Microsoft SDK that chains Joinery.Dovetail.Sdk, which detects the host, adds the Dovetail packages and emits the bootstrapping</PackageDescription>
    <PackageTags>$(PackageTags);aspire;dotnet-aspire;apphost</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Aspire packages the SDK adds to every AppHost (see Sdk/Sdk.props), at the versions Directory.Packages.props pins. -->
    <DovetailMirrorPackage Include="Aspire.Hosting.AppHost" Property="DovetailAspireHostingAppHostVersion" />
    <DovetailMirrorPackage Include="Aspire.Hosting.Dotnet" Property="DovetailAspireHostingDotnetVersion" />
  </ItemGroup>
</Project>
