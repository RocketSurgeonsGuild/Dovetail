<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The SDK this one mirrors: src/Sdks/Directory.Build.targets writes the package's description and Sdk/Packages.props from it. -->
    <DovetailMicrosoftSdk>Aspire.AppHost.Sdk</DovetailMicrosoftSdk>
    <!-- Aspire.AppHost.Sdk comes from NuGet, so Packages.props also pins the version Sdk.props imports it at. -->
    <DovetailMicrosoftSdkVersionProperty>DovetailAspireAppHostSdkVersion</DovetailMicrosoftSdkVersionProperty>
    <PackageTags>$(PackageTags);aspire</PackageTags>
  </PropertyGroup>
</Project>
