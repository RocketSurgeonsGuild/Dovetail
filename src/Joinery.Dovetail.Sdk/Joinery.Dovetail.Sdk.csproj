<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageType>MSBuildSdk</PackageType>
    <NoBuildOutput>true</NoBuildOutput>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <ImplicitUsings>disable</ImplicitUsings>
    <PackageDescription>MSBuild SDK for Dovetail — auto-selects packages and emits bootstrapping based on host SDK</PackageDescription>
    <PackageTags>$(PackageTags);sdk;msbuild</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Sdk/**" />
    <None Include="Sdk/**" Pack="true" PackagePath="Sdk/" />
    <Using Remove="**" />
  </ItemGroup>

  <!--
      Every Dovetail package ships at the same version, so the SDK adds each one at $(DovetailVersion), which defaults to the
      version of the SDK itself. An application can set DovetailVersion to move every package the SDK adds together.
  -->
  <Target Name="_DovetailGeneratePackagesProps" BeforeTargets="_GetPackageFiles;Pack">
    <PropertyGroup>
      <_DovetailPackagesProps>$(IntermediateOutputPath)Packages.props</_DovetailPackagesProps>
    </PropertyGroup>
    <ItemGroup>
      <!-- %24 is $ and %27 is ': the file reads the consumer's properties, which must not be expanded here -->
      <_DovetailPackagesPropsLine Include="&lt;Project&gt;" />
      <_DovetailPackagesPropsLine Include="&lt;!-- Generated when Joinery.Dovetail.Sdk is packed. The version is only set when the application has not set it already. --&gt;" />
      <_DovetailPackagesPropsLine Include="&lt;PropertyGroup&gt;" />
      <_DovetailPackagesPropsLine Include="&lt;DovetailVersion Condition=&quot;%27%24(DovetailVersion)%27 == %27%27&quot;&gt;$(Version)&lt;/DovetailVersion&gt;" />
      <_DovetailPackagesPropsLine Include="&lt;/PropertyGroup&gt;" />
      <_DovetailPackagesPropsLine Include="&lt;/Project&gt;" />
    </ItemGroup>
    <WriteLinesToFile File="$(_DovetailPackagesProps)" Lines="@(_DovetailPackagesPropsLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(_DovetailPackagesProps)" Pack="true" PackagePath="Sdk" />
      <FileWrites Include="$(_DovetailPackagesProps)" />
    </ItemGroup>
  </Target>
</Project>
