<Project>
  <!-- DovetailVersion: the version of every Dovetail package this SDK adds, generated when the SDK is packed -->
  <Import Project="$(MSBuildThisFileDirectory)Packages.props" />

  <!--
      Register host detection and the expansion of DovetailSdkImplicitPackageReference items to run via MSBuild's
      CustomAfterMicrosoftCommonTargets extensibility point, after the whole project has been evaluated: host detection reads
      project-set properties like $(OutputType). They are registered here, not in Sdk.targets, because this file is imported before
      the consuming project's own body however the SDK is applied: in a Directory.Build.props (Sdk="Joinery.Dovetail.Sdk"), or in
      the project itself (an <Sdk Name="Joinery.Dovetail.Sdk" Version="..." /> element, or a file-based app's #:sdk directive).
      Sdk.targets comes at the end of the project in the second case, after Microsoft.Common.targets has imported the list.

      MSBuild imports the files of the list in order:
        - Joinery.Dovetail.HostDetection.targets first, so the files after it can read the DovetailHost items it declares.
        - ImplicitPackageReferences.targets last, so it expands the items of every file before it. An SDK that chains this one adds
          its own files to the list before importing this file (as Rocket.Surgery.LaunchPad.Sdk does), and they land between the two.
  -->
  <PropertyGroup>
    <CustomAfterMicrosoftCommonTargets>$(MSBuildThisFileDirectory)Joinery.Dovetail.HostDetection.targets;$(CustomAfterMicrosoftCommonTargets);$(MSBuildThisFileDirectory)ImplicitPackageReferences.targets</CustomAfterMicrosoftCommonTargets>
  </PropertyGroup>
</Project>
