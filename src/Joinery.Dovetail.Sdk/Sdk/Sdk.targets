<Project>
  <!--
      Registered here rather than in Sdk.props, so it comes after every file added to CustomAfterMicrosoftCommonTargets before
      this point: Joinery.Dovetail.HostDetection.targets (Sdk.props), and the files of an SDK that chains this one from its own
      Sdk.props and then imports this file from its Sdk.targets. MSBuild imports the files of the list in order, so this one turns
      the DovetailSdkImplicitPackageReference items all of them declare into PackageReferences.
  -->
  <PropertyGroup>
    <CustomAfterMicrosoftCommonTargets>$(CustomAfterMicrosoftCommonTargets);$(MSBuildThisFileDirectory)ImplicitPackageReferences.targets</CustomAfterMicrosoftCommonTargets>
  </PropertyGroup>
</Project>
