<Project>
    <!--
        A lighter-weight way to declare a package the SDK injects into a consumer's build.
        Add one item instead of a full PackageReference block:

            <DovetailSdkImplicitPackageReference Include="Some.Package"
                                                 Version="$(SomePackageVersion)"
                                                 Condition="'$(SomeSwitch)' == 'true'"
                                                 PrivateAssets="all"
                                                 IncludeAssets="runtime; build; native; contentfiles; analyzers" />

        Condition is the only attribute handled specially (it controls whether the item is even
        added, same as on any MSBuild item). Every other attribute — PrivateAssets, IncludeAssets,
        ExcludeAssets, NoWarn, Aliases, GeneratePathProperty, whatever PackageReference supports —
        is carried over automatically: `Include="@(DovetailSdkImplicitPackageReference)"` below copies
        every metadata key from the source items onto the new PackageReference items, so there is
        nothing to special-case here as new metadata needs come up.

        Expanded into real PackageReference items below — eagerly, at evaluation time, not from a
        Target, because NuGet restore only ever sees items that exist by the time evaluation
        finishes; anything added later by a Target's execution is invisible to it. The expansion
        only sees the items declared before it, so Sdk.props registers this file as the LAST entry
        of CustomAfterMicrosoftCommonTargets: after Joinery.Dovetail.HostDetection.targets, and after
        the files an SDK that chains this one (Rocket.Surgery.LaunchPad.Sdk, for one) adds from its
        own Sdk.props before importing this SDK's, so those can declare DovetailSdkImplicitPackageReference
        items too. It also has to come before the project's nuget.g.targets, whose package targets read
        the PackageReferences (Joinery.Dovetail's implicit using, for one). A package the consumer
        already references directly is left alone rather than duplicated.
    -->
    <ItemGroup>
        <PackageReference Include="@(DovetailSdkImplicitPackageReference)"
                          Condition="@(PackageReference->AnyHaveMetadataValue('Identity', '%(DovetailSdkImplicitPackageReference.Identity)')) != 'true'"
                          IsImplicitlyDefined="true" />
    </ItemGroup>
</Project>
