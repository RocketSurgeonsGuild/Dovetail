<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RuntimeAsyncBrowserWasmAsset>true</RuntimeAsyncBrowserWasmAsset>
    <PackageDescription>Adds an OpenTelemetry joint, so libraries can add their tracing, metrics and logging setup to the application's IOpenTelemetryBuilder.</PackageDescription>
    <PackageTags>$(PackageTags);opentelemetry;otel;observability;tracing;metrics</PackageTags>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <DovetailJoint Include="OpenTelemetry" Namespace="Joinery.Dovetail.Joints" ParameterType="global::OpenTelemetry.IOpenTelemetryBuilder" ParameterName="builder" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OpenTelemetry"/>
    <ProjectReference Include="..\Joinery.Dovetail\Joinery.Dovetail.csproj"/>
  </ItemGroup>
</Project>
