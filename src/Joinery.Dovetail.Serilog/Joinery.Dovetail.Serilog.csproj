<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <RuntimeAsyncBrowserWasmAsset>true</RuntimeAsyncBrowserWasmAsset>
        <PackageDescription>Provides Serilog support for a Rocket Surgery Application</PackageDescription>
        <PackageTags>$(PackageTags);Serilog</PackageTags>
        <!-- The only reflection is reading the Serilog configuration section (SerilogLoggerRegistration); it is opt-in, guarded and documented. -->
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>
    <ItemGroup>
    <DovetailJoint Include="Serilog" Namespace="Joinery.Dovetail.Joints" ProvideServices="true" ParameterType="global::Serilog.LoggerConfiguration" ParameterName="loggerConfiguration" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Serilog" />
        <PackageReference Include="Serilog.Extensions.Logging" />
        <PackageReference Include="Serilog.Settings.Configuration" />
        <ProjectReference Include="..\Joinery.Dovetail\Joinery.Dovetail.csproj" />
    </ItemGroup>
</Project>
