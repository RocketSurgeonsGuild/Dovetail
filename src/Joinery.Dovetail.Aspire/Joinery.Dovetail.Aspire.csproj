<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <RuntimeAsyncBrowserWasmAsset>true</RuntimeAsyncBrowserWasmAsset>
        <PackageDescription>Builds an Aspire AppHost from the application's joints, applying their configuration, services and logging to the IDistributedApplicationBuilder.</PackageDescription>
        <PackageTags>$(PackageTags);aspire;dotnet-aspire;apphost;distributed-application</PackageTags>
        <RootNamespace>Joinery.Dovetail</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Aspire.Hosting.Tests" />
        <PackageReference Include="Aspire.Hosting" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Joinery.Dovetail\Joinery.Dovetail.csproj" />
        <DovetailJoint Include="DistributedApplicationBuilder" ParameterType="global::Aspire.Hosting.IDistributedApplicationBuilder" ParameterName="builder" />
        <DovetailJoint Include="DistributedApplication" ParameterType="global::Aspire.Hosting.DistributedApplication" ParameterName="host" />
    </ItemGroup>
</Project>
