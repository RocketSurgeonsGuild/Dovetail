<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <TargetFramework>netstandard2.0</TargetFramework>
        <IsRoslynComponent>true</IsRoslynComponent>
        <DefineConstants>$(DefineConstants);ROSLYN_CURRENT</DefineConstants>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <NoWarn>$(NoWarn);MSB3277</NoWarn>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <GenerateAssemblyInfoManifest>false</GenerateAssemblyInfoManifest>
        <!-- The generator only reads its own constants; the dependency accessors load assemblies, which analyzers may not. -->
        <AssemblyInfoDependencies>false</AssemblyInfoDependencies>
        <_AnalyzersLocation>../Joinery.Dovetail.Analyzers.supports/bin/</_AnalyzersLocation>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
        <PackageReference Include="Polyfill" PrivateAssets="all" />
        <!-- The generator stamps [GeneratedCode] from its AssemblyInfo constants; nothing of it ships, so no manifest is written. -->
        <PackageReference Include="Rocket.Surgery.AssemblyInfo" PrivateAssets="all" />
        <ProjectReference Include="../Joinery.Dovetail.Analyzers.supports/Joinery.Dovetail.Analyzers.roslyn5.0.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
        <ProjectReference Include="../Joinery.Dovetail.Analyzers.supports/Joinery.Dovetail.Analyzers.roslyn5.3.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
        <ProjectReference Include="../Joinery.Dovetail.Analyzers.supports/Joinery.Dovetail.Analyzers.roslyn5.6.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
    </ItemGroup>
    <ItemGroup>
        <None Include="bin\$(Configuration)\netstandard2.0\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.9/cs" Visible="false" />
        <None Include="$(_AnalyzersLocation)roslyn5.0/$(Configuration)/netstandard2.0/$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.0/cs" Visible="false" />
        <None Include="$(_AnalyzersLocation)roslyn5.3/$(Configuration)/netstandard2.0/$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.3/cs" Visible="false" />
        <None Include="$(_AnalyzersLocation)roslyn5.6/$(Configuration)/netstandard2.0/$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.6/cs" Visible="false" />
    </ItemGroup>
</Project>
