<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <PackageDescription>
            Adds helpers to easily bootstrap a .NET MAUI application using conventions by just using the correct extension method. This adds
            additional configuration, logging and service injections by convention.
        </PackageDescription>
        <PackageTags>$(PackageTags);hosting;maui</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <DovetailJoint
            Include="MauiAppBuilder"
            Namespace="Dovetail.Joints"
            ParameterType="global::Microsoft.Maui.Hosting.MauiAppBuilder"
            ParameterName="builder"
        />
        <DovetailJoint Include="MauiApp" Namespace="Dovetail.Joints" ParameterType="global::Microsoft.Maui.Hosting.MauiApp" ParameterName="app" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Core" />
        <ProjectReference Include="../Dovetail/Dovetail.csproj" />
        <ProjectReference Include="../Dovetail.Hosting/Dovetail.Hosting.csproj" />
        <ProjectReference Include="../Dovetail.OpenTelemetry/Dovetail.OpenTelemetry.csproj" />
        <InternalsVisibleTo Include="Dovetail.Hosting.Maui.Tests" />
    </ItemGroup>
</Project>
