<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!--
            The Windows heads of an Uno app use the real WinUI (Windows App SDK) rather than Uno.UI, so Microsoft.UI.Xaml's
            Application, Window and UIElement are different types there: build against Uno.Extensions' Windows assets for them too.
        -->
        <TargetFrameworks>net10.0;net11.0;net10.0-windows10.0.19041;net11.0-windows10.0.19041</TargetFrameworks>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <!--
            A library with no resources of its own: the app generates the PRI (resource index). Generating or expanding PRIs here would
            only need the Windows-only MRT tooling, which also keeps the package buildable on Linux and macOS.
        -->
        <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
        <ExpandPriResources>false</ExpandPriResources>
        <PackageDescription>
            Adds helpers to easily bootstrap an Uno Platform application (Uno.Extensions.Hosting) using conventions by just using the correct
            extension method. This adds additional configuration, logging and service injections by convention.
        </PackageDescription>
        <PackageTags>$(PackageTags);hosting;uno</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <DovetailJoint
            Include="UnoApplicationBuilder"
            Namespace="Dovetail.Joints"
            ParameterType="global::Uno.Extensions.Hosting.IApplicationBuilder"
            ParameterName="builder"
        />
        <DovetailJoint
            Include="UnoHostBuilder"
            Namespace="Dovetail.Joints"
            ParameterType="global::Microsoft.Extensions.Hosting.IHostBuilder"
            ParameterName="builder"
        />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Uno.Extensions.Hosting.WinUI" />
        <PackageReference Include="Uno.Extensions.Navigation.WinUI" />
        <ProjectReference Include="../Dovetail/Dovetail.csproj" />
        <ProjectReference Include="../Dovetail.Hosting/Dovetail.Hosting.csproj" />
        <ProjectReference Include="../Dovetail.OpenTelemetry/Dovetail.OpenTelemetry.csproj" />
        <InternalsVisibleTo Include="Dovetail.Hosting.Uno.Tests" />
    </ItemGroup>
</Project>
