using Joinery.Dovetail;
using Joinery.Dovetail.Attributes;
using Joinery.Dovetail.Configuration.Yaml;
using Joinery.Dovetail.Joints;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.FileProviders;

/// <summary>
///     Default YAML (<c>.yaml</c>) app-settings convention for this project.
/// </summary>
[DovetailExport]
internal class YamlAppSettingsConfiguration : IConfigurationJoint
{
    /// <summary>
    ///     Adds the project's <c>{{ProjectName}}.yaml</c>, environment-specific, and local YAML app-settings files to the configuration.
    /// </summary>
    /// <param name="context">The context.</param>
    /// <param name="builder">The <see cref="IConfigurationBuilder" /> to add the YAML sources to.</param>
    public void Register(IDovetailContext context, IConfigurationBuilder builder)
    {
        var environmentName = context.Get<string>("EnvironmentName") ?? "Production";
        if (context.EmbeddedConfigurationAssembly is not null)
        {
            // Hosts without a file system read the copies the Dovetail SDK embedded into this assembly instead.
            var assembly = typeof(YamlAppSettingsConfiguration).Assembly;
            builder.AddYamlStream(
                DovetailEmbeddedConfiguration.OpenResource(assembly, "{{ProjectName}}.yaml", "appsettings.yaml")
             ?? throw new System.IO.FileNotFoundException($"The embedded configuration file '{{ProjectName}}.yaml' was not found in '{assembly.FullName}'.")
            );
            if (DovetailEmbeddedConfiguration.OpenResource(assembly, $"{{ProjectName}}.{environmentName}.yaml", $"appsettings.{environmentName}.yaml") is { } environment) builder.AddYamlStream(environment);
            if (DovetailEmbeddedConfiguration.OpenResource(assembly, "{{ProjectName}}.local.yaml", "appsettings.local.yaml") is { } local) builder.AddYamlStream(local);
            return;
        }

        // The output directory holds the files under the project's name. A file-based app reads them from next to its entry point file
        // instead, where they keep their source names, appsettings.yaml or {{ProjectName}}.yaml.
        // One file provider for the three files, rather than one each.
        var files = builder.GetFileProvider();
        builder.AddYamlFile(files, FileName(files, "{{ProjectName}}.yaml", "appsettings.yaml"), optional: false, reloadOnChange: false);
        builder.AddYamlFile(files, FileName(files, $"{{ProjectName}}.{environmentName}.yaml", $"appsettings.{environmentName}.yaml"), optional: true, reloadOnChange: false);
        builder.AddYamlFile(files, FileName(files, "{{ProjectName}}.local.yaml", "appsettings.local.yaml"), optional: true, reloadOnChange: false);
    }

    private static string FileName(IFileProvider files, string name, string fallback) =>
        files.GetFileInfo(name).Exists || !files.GetFileInfo(fallback).Exists ? name : fallback;
}
