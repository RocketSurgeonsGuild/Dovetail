using Joinery.Dovetail;
using Joinery.Dovetail.Attributes;
using Joinery.Dovetail.Configuration.Yaml;
using Joinery.Dovetail.Joints;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.FileProviders;

/// <summary>
///     Default YAML app-settings convention for this project, for files with either extension (<c>.yaml</c> or <c>.yml</c>).
/// </summary>
[DovetailExport]
internal class YamlAppSettingsConfiguration : IConfigurationJoint
{
    // .yaml first: when a layer has both, the .yml file is added after it and wins where they disagree.
    private static readonly string[] Extensions = { "yaml", "yml" };

    /// <summary>
    ///     Adds the project's <c>{{ProjectName}}.yaml</c> or <c>{{ProjectName}}.yml</c>, environment-specific, and local YAML app-settings
    ///     files to the configuration. One of the two base files is required; the other layers are optional, in either extension.
    /// </summary>
    /// <param name="context">The context.</param>
    /// <param name="builder">The <see cref="IConfigurationBuilder" /> to add the YAML sources to.</param>
    public void Register(IDovetailContext context, IConfigurationBuilder builder)
    {
        var environmentName = context.Get<string>("EnvironmentName") ?? "Production";
        if (context.EmbeddedConfigurationAssembly is not null)
        {
            // Hosts without a file system read the copies the Dovetail SDK embedded into this assembly instead.
            var assembly = typeof(YamlAppSettingsConfiguration).Assembly;
            var found = false;
            foreach (var extension in Extensions)
            {
                if (DovetailEmbeddedConfiguration.OpenResource(assembly, $"{{ProjectName}}.{extension}", $"appsettings.{extension}") is not { } settings) continue;
                builder.AddYamlStream(settings);
                found = true;
            }

            if (!found)
            {
                throw new System.IO.FileNotFoundException($"Neither '{{ProjectName}}.yaml' nor '{{ProjectName}}.yml' was found embedded in '{assembly.FullName}'.");
            }

            foreach (var extension in Extensions)
            {
                if (DovetailEmbeddedConfiguration.OpenResource(assembly, $"{{ProjectName}}.{environmentName}.{extension}", $"appsettings.{environmentName}.{extension}") is { } environment) builder.AddYamlStream(environment);
            }

            foreach (var extension in Extensions)
            {
                if (DovetailEmbeddedConfiguration.OpenResource(assembly, $"{{ProjectName}}.local.{extension}", $"appsettings.local.{extension}") is { } local) builder.AddYamlStream(local);
            }

            return;
        }

        // The output directory holds the files under the project's name. A file-based app reads them from next to its entry point file
        // instead, where they keep their source names, appsettings.{yaml,yml} or {{ProjectName}}.{yaml,yml}.
        // One file provider for every file, rather than one each.
        var files = builder.GetFileProvider();
        var baseFiles = new global::System.Collections.Generic.List<string>();
        foreach (var extension in Extensions)
        {
            var name = FileName(files, $"{{ProjectName}}.{extension}", $"appsettings.{extension}");
            if (files.GetFileInfo(name).Exists) baseFiles.Add(name);
        }

        // Neither exists: the required .yaml file reports itself missing when the configuration is built.
        if (baseFiles.Count == 0) baseFiles.Add("{{ProjectName}}.yaml");
        foreach (var name in baseFiles)
        {
            builder.AddYamlFile(files, name, optional: false, reloadOnChange: false);
        }

        foreach (var extension in Extensions)
        {
            builder.AddYamlFile(files, FileName(files, $"{{ProjectName}}.{environmentName}.{extension}", $"appsettings.{environmentName}.{extension}"), optional: true, reloadOnChange: false);
        }

        foreach (var extension in Extensions)
        {
            builder.AddYamlFile(files, FileName(files, $"{{ProjectName}}.local.{extension}", $"appsettings.local.{extension}"), optional: true, reloadOnChange: false);
        }
    }

    private static string FileName(IFileProvider files, string name, string fallback) =>
        files.GetFileInfo(name).Exists || !files.GetFileInfo(fallback).Exists ? name : fallback;
}
