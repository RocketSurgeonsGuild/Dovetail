using Joinery.Dovetail;
using Joinery.Dovetail.Attributes;
using Joinery.Dovetail.Configuration.Toml;
using Joinery.Dovetail.Joints;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.FileProviders;
using Tomlyn.Extensions.Configuration;

/// <summary>
///     Default TOML app-settings convention for this project.
/// </summary>
[DovetailExport]
internal class TomlAppSettingsConfiguration : IConfigurationJoint
{
    /// <summary>
    ///     Adds the project's <c>{{ProjectName}}.toml</c>, environment-specific, and local TOML app-settings files to the configuration.
    /// </summary>
    /// <param name="context">The context.</param>
    /// <param name="builder">The <see cref="IConfigurationBuilder" /> to add the TOML sources to.</param>
    public void Register(IDovetailContext context, IConfigurationBuilder builder)
    {
        var environmentName = context.Get<string>("EnvironmentName") ?? "Production";
        if (context.EmbeddedConfigurationAssembly is not null)
        {
            // Hosts without a file system read the copies the Dovetail SDK embedded into this assembly instead.
            var assembly = typeof(TomlAppSettingsConfiguration).Assembly;
            builder.AddTomlStream(
                DovetailEmbeddedConfiguration.OpenResource(assembly, "{{ProjectName}}.toml", "appsettings.toml")
             ?? throw new System.IO.FileNotFoundException($"The embedded configuration file '{{ProjectName}}.toml' was not found in '{assembly.FullName}'.")
            );
            if (DovetailEmbeddedConfiguration.OpenResource(assembly, $"{{ProjectName}}.{environmentName}.toml", $"appsettings.{environmentName}.toml") is { } environment) builder.AddTomlStream(environment);
            if (DovetailEmbeddedConfiguration.OpenResource(assembly, "{{ProjectName}}.local.toml", "appsettings.local.toml") is { } local) builder.AddTomlStream(local);
            return;
        }

        // The output directory holds the files under the project's name. The application's own files can also be read where they keep
        // their source names, appsettings.toml or {{ProjectName}}.toml: next to a file-based app's entry point file, or in its project
        // directory. One file provider for the three files, rather than one each.
        var source = SourceName(context);
        var files = Find(builder.GetFileProvider(), ref source, "toml");
        builder.AddTomlFile(files, FileName(files, "{{ProjectName}}.toml", $"{source}.toml"), optional: false, reloadOnChange: false);
        builder.AddTomlFile(files, FileName(files, $"{{ProjectName}}.{environmentName}.toml", $"{source}.{environmentName}.toml"), optional: true, reloadOnChange: false);
        builder.AddTomlFile(files, FileName(files, "{{ProjectName}}.local.toml", $"{source}.local.toml"), optional: true, reloadOnChange: false);
    }

    /// <summary>
    ///     The other name to look for this project's files under: <c>appsettings</c>, the name the application's own files keep in its
    ///     project directory and next to a file-based app's entry point file. A library never looks for it, since there it would find the
    ///     application's files: it uses <c>{{ProjectName}}</c> again. The application is the project the host is named after (its
    ///     <c>ApplicationName</c>).
    /// </summary>
    private static string SourceName(IDovetailContext context) =>
        context.Get<string>("ApplicationName") is { Length: > 0, } applicationName
     && !string.Equals(applicationName, "{{ProjectName}}", System.StringComparison.OrdinalIgnoreCase)
            ? "{{ProjectName}}"
            : "appsettings";

    /// <summary>
    ///     Where this project's files are read from: the host's files when its base file is there. Otherwise the application's base
    ///     directory (its output directory) when the build copied the base file there, under the project's name, as it does a library's,
    ///     so <c>dotnet run</c> from any directory, or a host whose content root is its project directory, still finds them.
    /// </summary>
    private static IFileProvider Find(IFileProvider files, ref string source, params string[] extensions)
    {
        foreach (var extension in extensions)
        {
            if (files.GetFileInfo($"{{ProjectName}}.{extension}").Exists || files.GetFileInfo($"{source}.{extension}").Exists) return files;
        }

        var applicationDirectory = System.AppContext.BaseDirectory;
        foreach (var extension in extensions)
        {
            if (!System.IO.File.Exists(System.IO.Path.Combine(applicationDirectory, $"{{ProjectName}}.{extension}"))) continue;
            source = "{{ProjectName}}";
            return new PhysicalFileProvider(applicationDirectory);
        }

        return files;
    }

    private static string FileName(IFileProvider files, string name, string fallback) =>
        files.GetFileInfo(name).Exists || !files.GetFileInfo(fallback).Exists ? name : fallback;
}
