using Joinery.Dovetail;
using Joinery.Dovetail.Attributes;
using Joinery.Dovetail.Configuration.Toml;
using Joinery.Dovetail.Joints;
using Microsoft.Extensions.Configuration;
using Tomlyn.Extensions.Configuration;

/// <summary>
///     Default TOML app-settings convention for this project.
/// </summary>
[DovetailExport]
internal class TomlAppSettingsConfiguration : IConfigurationJoint
{
    /// <summary>
    ///     Adds the project's <c>{{ProjectName}}.toml</c>, environment-specific, and local TOML app-settings files to the configuration.
    /// </summary>
    /// <param name="context">The context.</param>
    /// <param name="builder">The <see cref="IConfigurationBuilder" /> to add the TOML sources to.</param>
    public void Register(IDovetailContext context, IConfigurationBuilder builder)
    {
        var environmentName = context.Get<string>("EnvironmentName") ?? "Production";
        if (context.EmbeddedConfigurationAssembly is not null)
        {
            // Hosts without a file system read the copies the Dovetail SDK embedded into this assembly instead.
            var assembly = typeof(TomlAppSettingsConfiguration).Assembly;
            builder.AddTomlStream(
                DovetailEmbeddedConfiguration.OpenResource(assembly, "{{ProjectName}}.toml", "appsettings.toml")
             ?? throw new System.IO.FileNotFoundException($"The embedded configuration file '{{ProjectName}}.toml' was not found in '{assembly.FullName}'.")
            );
            if (DovetailEmbeddedConfiguration.OpenResource(assembly, $"{{ProjectName}}.{environmentName}.toml", $"appsettings.{environmentName}.toml") is { } environment) builder.AddTomlStream(environment);
            if (DovetailEmbeddedConfiguration.OpenResource(assembly, "{{ProjectName}}.local.toml", "appsettings.local.toml") is { } local) builder.AddTomlStream(local);
            return;
        }

        builder.AddTomlFile("{{ProjectName}}.toml", optional: false, reloadOnChange: false);
        builder.AddTomlFile($"{{ProjectName}}.{environmentName}.toml", optional: true, reloadOnChange: false);
        builder.AddTomlFile("{{ProjectName}}.local.toml", optional: true, reloadOnChange: false);
    }
}
