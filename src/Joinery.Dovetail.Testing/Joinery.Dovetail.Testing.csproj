<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <RuntimeAsyncBrowserWasmAsset>true</RuntimeAsyncBrowserWasmAsset>
        <PackageDescription>Shares test setup between projects as joints that run only when the host is a unit test host, without depending on a test framework.</PackageDescription>
        <PackageTags>$(PackageTags);testing;unit-testing;test-host</PackageTags>
      <RootNamespace>Joinery.Dovetail.Testing</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Joinery.Dovetail/Joinery.Dovetail.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Aspire.Hosting.Tests" />
        <PackageReference Include="Aspire.Hosting.Testing" />
    </ItemGroup>
    <ItemGroup>
        <DovetailJoint
            Include="Testing"
            Namespace="Joinery.Dovetail.Testing.Joints"
        />
    </ItemGroup>
</Project>
