<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <RuntimeAsyncBrowserWasmAsset>true</RuntimeAsyncBrowserWasmAsset>
        <PackageDescription>
            Adds helpers to easily bootstrap an application using conventions by
            just using the correct extension method. This adds command line operations, additional
            configuration, logging and service injections by convention. One package for every host: the helpers for the generic
            host, ASP.NET Core, .NET MAUI, Uno Platform and Blazor WebAssembly are emitted into the application when it references
            that host's framework.
        </PackageDescription>
        <PackageTags>$(PackageTags);hosting;generic host;aspnetcore;maui;uno;blazor;webassembly</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <!--
            Unconstrained, so it is the builder joint of every host: IHostApplicationJoint<HostApplicationBuilder>,
            IHostApplicationJoint<WebApplicationBuilder>, IHostApplicationJoint<MauiAppBuilder>, IHostApplicationJoint<WebAssemblyHostBuilder>,
            and for Uno IHostApplicationJoint<IApplicationBuilder> and IHostApplicationJoint<IHostBuilder>. Contravariance lets
            IHostApplicationJoint<IHostApplicationBuilder> run for every host whose builder is one.
        -->
        <DovetailJoint
            Include="HostApplication"
            Namespace="Joinery.Dovetail.Joints"
            GenericParameter="TBuilder"
            ParameterType="TBuilder"
            ParameterName="builder"
        />
        <DovetailJoint
            Include="Host"
            Namespace="Joinery.Dovetail.Joints"
            GenericParameter="THost"
            GenericConstraint="global::Microsoft.Extensions.Hosting.IHost"
            ParameterType="THost"
            ParameterName="host"
        />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Joinery.Dovetail\Joinery.Dovetail.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Joinery.Dovetail.Hosting.AspNetCore.Tests" />
        <InternalsVisibleTo Include="Joinery.Dovetail.Hosting.Tests" />
        <!--
            Only the abstractions (IHostEnvironment, IHost): the helpers this package emits compile against the application's own
            references, so the generic-host helper appears once the application references Microsoft.Extensions.Hosting itself.
        -->
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    </ItemGroup>
    <ItemGroup>
        <None Include="build/*.*" Pack="true" PackagePath="build" />
        <None Include="buildMultiTargeting/*.*" Pack="true" PackagePath="buildMultiTargeting" />
        <None Include="buildTransitive/*.*" Pack="true" PackagePath="buildTransitive" />
    </ItemGroup>
</Project>