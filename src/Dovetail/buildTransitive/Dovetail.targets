<Project>
    <Import Project="$(MSBuildThisFileDirectory)../build/$(MSBuildThisFile)" />

    <!--
        NuGet imports buildTransitive/ instead of build/ whenever a package ships both, so
        build/Dovetail.props (which adds the implicit `using Dovetail;`) never reaches package
        consumers. Add the using here instead, but only for projects that reference the Dovetail
        package (Joinery.Dovetail) directly - including the implicit reference Dovetail.Sdk adds - so
        projects that merely get Dovetail transitively stay untouched. This file is imported from
        nuget.g.targets, after the project body and Dovetail.Sdk's host detection, so every direct
        PackageReference is visible.
    -->
    <ItemGroup Condition="('$(ImplicitUsings)' == 'true' or '$(ImplicitUsings)' == 'enable') and @(PackageReference->AnyHaveMetadataValue('Identity', 'Joinery.Dovetail')) == 'true' and @(Using->AnyHaveMetadataValue('Identity', 'Dovetail')) != 'true'">
        <Using Include="Dovetail" />
    </ItemGroup>
</Project>
