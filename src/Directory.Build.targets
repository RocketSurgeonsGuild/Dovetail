<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />
  <!--
      Build infrastructure rather than Dovetail consumers: no configuration schema files, which for Joinery.Dovetail.Build.Tasks would
      also need the very tasks it builds.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Joinery.Dovetail.Build.Tasks' or '$(MSBuildProjectName)' == 'Joinery.Dovetail.Sdk' or $(MSBuildProjectName.StartsWith('Joinery.Dovetail.Analyzers'))">
    <DovetailConfigurationSchema>false</DovetailConfigurationSchema>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)Joinery.Dovetail/build/Joinery.Dovetail.targets" />
  <Import Project="$(MSBuildThisFileDirectory)Joinery.Dovetail.Build.Tasks/Joinery.Dovetail.Build.Tasks.InRepo.targets" />
  <!--
    Analyzer release tracking (RS2000-RS2008) for every analyzer/generator project:
    https://github.com/dotnet/roslyn/blob/main/src/RoslynAnalyzers/Microsoft.CodeAnalysis.Analyzers/ReleaseTrackingAnalyzers.Help.md
    On release, move the entries from AnalyzerReleases.Unshipped.md into a new "## Release x.y.z" section of AnalyzerReleases.Shipped.md.
  -->
  <ItemGroup Condition="'$(EnforceExtendedAnalyzerRules)' == 'true'">
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md;AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Joinery.Dovetail.Aspire.Tests" />
    <InternalsVisibleTo Include="Joinery.Dovetail.Autofac.Tests" />
    <InternalsVisibleTo Include="Joinery.Dovetail.Configuration.Runtime.Tests" />
    <InternalsVisibleTo Include="Joinery.Dovetail.DryIoc.Tests" />
    <InternalsVisibleTo Include="Joinery.Dovetail.Hosting.AspNetCore.Tests" />
    <InternalsVisibleTo Include="Joinery.Dovetail.Hosting.Maui.Tests" />
    <InternalsVisibleTo Include="Joinery.Dovetail.Hosting.Uno.Tests" />
    <InternalsVisibleTo Include="Joinery.Dovetail.Hosting.Tests" />
    <InternalsVisibleTo Include="Joinery.Dovetail.WebAssembly.Hosting.Tests" />
    <InternalsVisibleTo Include="Joinery.Dovetail.OpenTelemetry.Tests" />
    <InternalsVisibleTo Include="Joinery.Dovetail.Stashbox.Tests" />
    <InternalsVisibleTo Include="Joinery.Dovetail.Tests" />
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)Joinery.Dovetail.Analyzers\Joinery.Dovetail.Analyzers.csproj"
      IncludeAssets="analyzers;build;buildMultitargeting;buildTransitive"
      ExcludeAssets="compile;runtime;native"
      PrivateAssets="contentfiles;build;buildMultitargeting;buildTransitive"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      Condition="'$(MSBuildProjectName)' != 'Joinery.Dovetail' and '$(MSBuildProjectName)' != 'Joinery.Dovetail.Sdk' and '$(MSBuildProjectName)' != 'Joinery.Dovetail.Build.Tasks' and !$(MSBuildProjectName.StartsWith('Joinery.Dovetail.Analyzers'))"
    />
    <!--
      NuGet's default PrivateAssets (contentfiles;analyzers;build) would pack every integration package's dependency on
      Dovetail as exclude="Build,Analyzers", and include flags intersect down the dependency chain - so a project that only
      references, say, Joinery.Dovetail.Hosting never ran Dovetail's generator. Let analyzers flow; build stays private as before
      (Dovetail's buildTransitive assets already reach those projects).
    -->
    <ProjectReference Update="$(MSBuildThisFileDirectory)Joinery.Dovetail\Joinery.Dovetail.csproj" PrivateAssets="contentfiles;build" />
  </ItemGroup>
</Project>
