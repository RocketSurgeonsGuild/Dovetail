<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RuntimeAsyncBrowserWasmAsset>true</RuntimeAsyncBrowserWasmAsset>
    <PackageDescription>Renders the joints an IDovetailContext resolved, and how they connect, as a Mermaid flowchart.</PackageDescription>
    <PackageTags>$(PackageTags);mermaid;diagram;diagnostics;visualization</PackageTags>
    <IsTrimmable>true</IsTrimmable>
    <RootNamespace>Joinery.Dovetail</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Interactive" />
    <PackageReference Include="FoggyBalrog.MermaidDotNet" />
    <ProjectReference Include="..\Joinery.Dovetail\Joinery.Dovetail.csproj" />
  </ItemGroup>
</Project>