<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
        MSBuild.ProjectCreation loads MSBuild in-proc from an SDK of the host's major version, and only SDK 11 is
        installed (mise adds just the .NET 10 runtime). The scaffolded projects cover both target frameworks instead,
        through TargetFrameworksAttribute.
    -->
    <TargetFramework>net11.0</TargetFramework>
    <!--
        MSB3277: Microsoft.Build references a newer NuGet.Frameworks (7.10, shipped with the SDK) than the newest NuGet.* packages
        (7.9). Harmless: MSBuild and NuGet are loaded from the installed SDK at run time, so these only compile against.
    -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\sample\Sample.DependencyOne\Sample.DependencyOne.csproj" />
    <ProjectReference Include="..\..\sample\Sample.DependencyThree\Sample.DependencyThree.csproj" />
    <ProjectReference Include="..\..\sample\Sample.DependencyTwo\Sample.DependencyTwo.csproj" />
    <ProjectReference Include="..\..\src\Joinery.Dovetail.Serilog\Joinery.Dovetail.Serilog.csproj" />
    <ProjectReference Include="..\..\src\Joinery.Dovetail\Joinery.Dovetail.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The instance validator of the schema tests (ConfigurationSchemaSerilogTests); it needs nothing else of that project. -->
    <Compile Include="..\Joinery.Dovetail.Build.Tasks.Tests\SchemaInstanceValidator.cs" LinkBase="Linked" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MSBuild.ProjectCreation" />
    <!-- Load all of MSBuild from the SDK (MSBuildAssemblyResolver): copies from these packages don't match its Microsoft.Build.dll. -->
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime" />
    <PackageReference Include="MSBuild.StructuredLogger.Utils" />
    <PackageReference Include="NuGet.Packaging" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Interactive" />
  </ItemGroup>

  <!--
      These tests scaffold throwaway consumer projects that restore Dovetail packages from
      artifacts/nuget(-local) (see SdkTestProject.cs / Config.NugetArtifactsDirectory), so the
      packages need to exist and be current before the tests run. Repack every src/*.csproj
      (recursively) on every build of this test project rather than requiring a separate manual
      pack step; projects with IsPackable=false (e.g. the Joinery.Dovetail.Analyzers.supports roslynX.Y
      helper projects) simply no-op since NuGet's own Pack target is gated on that flag.
  -->
  <ItemGroup>
    <_DovetailSrcProject Include="$(MSBuildThisFileDirectory)..\..\src\**\*.csproj" />
  </ItemGroup>

  <Target Name="PackDovetailSourcePackages" BeforeTargets="Build">
    <!--
        Each target framework's inner build asks for the packages. Route every request to one call without a
        TargetFramework: MSBuild caches it, so the packages are built once per build rather than once (and
        concurrently) per framework, and the src projects never inherit this project's TargetFramework.
    -->
    <MSBuild
      Projects="$(MSBuildProjectFullPath)"
      Targets="_PackDovetailSourcePackages"
      Properties="Configuration=$(Configuration)"
      RemoveProperties="TargetFramework;RuntimeIdentifier"
    />
  </Target>

  <Target Name="_PackDovetailSourcePackages">
    <!--
        artifacts/nuget-local also accumulates packages from other pack invocations (e.g. a
        Release/CI-style GitVersion-numbered pack run locally). SdkTestProject picks up every
        Dovetail.* nupkg it finds there and hands the highest version to the scaffolded consumer's
        global.json, so a stale higher-SemVer leftover silently wins over the package this target
        is about to rebuild from current source - masking real fixes/regressions. Clear old ones
        first so only this run's fresh packages are ever visible to the tests.
    -->
    <ItemGroup>
      <_StaleDovetailPackage Include="$(MSBuildThisFileDirectory)..\..\artifacts\nuget-local\Joinery.Dovetail*.nupkg;$(MSBuildThisFileDirectory)..\..\artifacts\nuget-local\Joinery.Dovetail*.snupkg" />
    </ItemGroup>
    <Delete Files="@(_StaleDovetailPackage)" />
    <!--
        Restore and Pack run as separate calls: with "Restore;Pack" in one call, Pack reuses the evaluation made before
        restore, so on a clean checkout (no obj/project.assets.json yet) it builds without any package-provided
        references and fails (e.g. CS0518 'System.String' is not defined). The extra global property gives the restore
        call its own evaluation, so Pack evaluates afresh once the restore outputs exist.
        Not in parallel: a project's restore writes the assets file of every project it references, so restoring projects that
        share references at the same time races on those files ("The file '.../obj/project.assets.json' already exists").
    -->
    <MSBuild
      Projects="@(_DovetailSrcProject)"
      Targets="Restore"
      Properties="Configuration=$(Configuration);VersionSuffix=local;_DovetailSdkTestsRestore=true"
      RemoveProperties="TargetFramework;RuntimeIdentifier"
      BuildInParallel="false"
    />
    <!--
        Packed as a prerelease (1.0.0-local), as any dev build is: the packages depend on prereleases (the .NET 11 RC packages for
        net11.0, and DryIoc's preview), which a stable version would flag as NU5104.
    -->
    <MSBuild
      Projects="@(_DovetailSrcProject)"
      Targets="Pack"
      Properties="Configuration=$(Configuration);VersionSuffix=local"
      RemoveProperties="TargetFramework;RuntimeIdentifier"
      BuildInParallel="true"
    />
  </Target>
</Project>
