<?xml version="1.0" encoding="utf-8"?>
<!--
    Code coverage settings for the CI build (build/appsettings.yaml points the pipeline's TestSolution module at this file).

    Coverage is collected for Dovetail's own assemblies only. Without an include list it also covered everything else
    that had sources: the throwaway app/lib/web projects the SDK tests scaffold (6000+ lines of generated code) and
    referenced test helper packages, which padded the report and slowed report generation.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <Format>Cobertura</Format>
          <CodeCoverage>
            <EnableStaticManagedInstrumentation>True</EnableStaticManagedInstrumentation>
            <EnableDynamicManagedInstrumentation>True</EnableDynamicManagedInstrumentation>
            <!--
                The SDK tests start hundreds of `dotnet build`/`run`/`publish` processes. Collecting from them attaches the
                coverage profiler to every MSBuild node and compiler run they start, for a few points of
                Joinery.Dovetail.Build.Tasks coverage that its own unit tests (Joinery.Dovetail.Build.Tasks.Tests) mostly have.
            -->
            <CollectFromChildProcesses>False</CollectFromChildProcesses>
            <ModulePaths>
              <Include>
                <ModulePath>.*[\\/]Joinery\.Dovetail(\.[^\\/]+)?\.dll$</ModulePath>
              </Include>
              <Exclude>
                <ModulePath>.*\.Tests\.dll$</ModulePath>
              </Exclude>
            </ModulePaths>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
