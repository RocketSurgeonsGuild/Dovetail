<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\Dovetail.Hosting.Uno\Dovetail.Hosting.Uno.csproj" />
        <ProjectReference Include="..\..\src\Dovetail.Configuration.Json\Dovetail.Configuration.Json.csproj" />
        <ProjectReference Include="..\..\src\Dovetail.Stashbox\Dovetail.Stashbox.csproj" />

        <!-- Mirrors what the Dovetail SDK's Uno detection adds (see src/Dovetail.Sdk/Sdk/Dovetail.HostDetection.targets). -->
        <DovetailHost
            Include="Uno"
            HostBuilderType="global::Uno.Extensions.Hosting.IApplicationBuilder"
            HostBuilderName="builder"
            HostType="global::Microsoft.Extensions.Hosting.IHost"
            HelperName="global::Dovetail.DovetailUnoHelpers"
            BuildExpression=", static b => b.Build(), typeof(GeneratedDovetailUnoExtensions).Assembly"
            NavigateEntryPoint="true"
        />
    </ItemGroup>
</Project>
