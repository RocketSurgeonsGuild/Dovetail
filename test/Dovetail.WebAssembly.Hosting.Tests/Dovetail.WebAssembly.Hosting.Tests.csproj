<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <_IsNet11OrGreater>$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))</_IsNet11OrGreater>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="Microsoft.Playwright" />
        <PackageReference Include="Verify.AngleSharp" />
        <PackageReference Include="Verify.Playwright" />
        <ProjectReference Include="..\..\src\Dovetail.Hosting.WebAssembly\Dovetail.Hosting.WebAssembly.csproj" />
        <ProjectReference Include="..\..\src\Dovetail.Configuration.Json\Dovetail.Configuration.Json.csproj" />
        <ProjectReference Include="..\..\src\Dovetail.Configuration.Yaml\Dovetail.Configuration.Yaml.csproj" />
        <PackageReference Include="bunit.web" />
    </ItemGroup>
    <!-- net10.0 hosts the sample in-process with the DevServer copy in DevServer/. -->
    <ItemGroup Condition="'$(_IsNet11OrGreater)' != 'true'">
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
        <ProjectReference Include="..\..\sample\Sample.BlazorWasm\Sample.BlazorWasm.csproj" />
    </ItemGroup>
    <!--
        net11.0 serves the sample's net11.0-browser build with the Blazor Gateway, which replaces the DevServer in
        .NET 11. Only the Gateway's location is used (its build targets would take over this project's RunCommand).
    -->
    <ItemGroup Condition="'$(_IsNet11OrGreater)' == 'true'">
        <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" IncludeAssets="none" PrivateAssets="all" GeneratePathProperty="true" />
        <ProjectReference
            Include="..\..\sample\Sample.BlazorWasm\Sample.BlazorWasm.csproj"
            SetTargetFramework="TargetFramework=net11.0-browser"
            ReferenceOutputAssembly="false"
        />
        <AssemblyMetadata Include="BlazorGatewayDll" Value="$(PkgMicrosoft_AspNetCore_Components_Gateway)/tools/blazor-gateway.dll" />
        <AssemblyMetadata
            Include="SampleIntermediateOutputPath"
            Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../sample/Sample.BlazorWasm/obj/$(Configuration)/net11.0-browser/'))"
        />
    </ItemGroup>
    <ItemGroup Condition="'$(_IsNet11OrGreater)' == 'true'">
        <Compile Remove="DevServer/**" />
    </ItemGroup>
</Project>
