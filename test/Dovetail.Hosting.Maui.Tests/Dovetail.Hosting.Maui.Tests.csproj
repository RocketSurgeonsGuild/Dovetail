<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\Dovetail.Hosting.Maui\Dovetail.Hosting.Maui.csproj" />
        <ProjectReference Include="..\..\src\Dovetail.Configuration.Json\Dovetail.Configuration.Json.csproj" />
        <ProjectReference Include="..\..\src\Dovetail.Stashbox\Dovetail.Stashbox.csproj" />

        <!-- Mirrors what the Dovetail SDK's MAUI detection adds (see src/Dovetail.Sdk/Sdk/Dovetail.HostDetection.targets). -->
        <DovetailHost
            Include="Maui"
            HostBuilderType="global::Microsoft.Maui.Hosting.MauiAppBuilder"
            HostBuilderName="builder"
            HostType="global::Microsoft.Maui.Hosting.MauiApp"
            HelperName="global::Dovetail.DovetailMauiHelpers"
            BuildExpression=", static b => b.Build(), typeof(GeneratedDovetailMauiExtensions).Assembly"
            SyncEntryPoint="true"
        />
        <AssemblyMetadata Include="DovetailEnvironmentName" Value="Testing" />
    </ItemGroup>
</Project>
