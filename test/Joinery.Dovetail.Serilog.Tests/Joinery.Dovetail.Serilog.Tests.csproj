<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <ProjectReference Include="..\..\src\Joinery.Dovetail.Serilog\Joinery.Dovetail.Serilog.csproj" />
        <ProjectReference Include="..\..\src\Joinery.Dovetail\Joinery.Dovetail.csproj" />
        <ProjectReference Include="..\..\src\Joinery.Dovetail.Hosting\Joinery.Dovetail.Hosting.csproj" />
        <ProjectReference Include="..\..\src\Joinery.Dovetail.OpenTelemetry\Joinery.Dovetail.OpenTelemetry.csproj" />

        <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
        <!-- A generic-host application turns OpenTelemetry on with it (DovetailOpenTelemetryJoint, emitted by Joinery.Dovetail.Hosting). -->
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />

        <DovetailHost
            Include="HostApplication"
            HostBuilderType="global::Microsoft.Extensions.Hosting.HostApplicationBuilder"
            HostBuilderName="builder"
            HostType="global::Microsoft.Extensions.Hosting.IHost"
            HelperName="global::Joinery.Dovetail.DovetailHostApplicationHelpers"
        />
        <DovetailHost
            Include="WebApplication"
            HostBuilderType="global::Microsoft.AspNetCore.Builder.WebApplicationBuilder"
            HostBuilderName="builder"
            HostType="global::Microsoft.AspNetCore.Builder.WebApplication"
            HelperName="global::Joinery.Dovetail.DovetailHostApplicationHelpers"
        />
    </ItemGroup>
</Project>
