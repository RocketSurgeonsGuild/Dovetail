<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\sample\AspireSample\AspireSample.csproj" />
        <ProjectReference Include="..\..\src\Joinery.Dovetail.Aspire\Joinery.Dovetail.Aspire.csproj" />
        <ProjectReference Include="..\..\src\Joinery.Dovetail.Aspire.Testing\Joinery.Dovetail.Aspire.Testing.csproj" />
    </ItemGroup>
    <ItemGroup>
        <DovetailHost
            Include="DistributedApplication"
            Namespace="Joinery.Dovetail.Joints"
            HostBuilderType="global::Aspire.Hosting.IDistributedApplicationBuilder"
            HostBuilderName="builder"
            HostType="global::Aspire.Hosting.DistributedApplication"
            HasBuildExpression="false"
        />
        <DovetailHost
            Include="DistributedApplicationTesting"
            Namespace="Joinery.Dovetail.Testing.Joints"
            HostBuilderType="global::Aspire.Hosting.Testing.IDistributedApplicationTestingBuilder"
            HostBuilderName="builder"
            HostType="global::Aspire.Hosting.DistributedApplication"
            HasBuildExpression="false"
        />
    </ItemGroup>
</Project>
