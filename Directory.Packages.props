<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Rocket.Surgery.AssemblyInfo" Version="2026.11.6" />
    <GlobalPackageReference Include="Microsoft.DotNet.ApiCompat.Task" Version="11.0.100" />
    <GlobalPackageReference Include="Spectre.Console.Analyzer" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="FoggyBalrog.MermaidDotNet" Version="0.21.0" />
    <PackageVersion Include="MSBuild.ProjectCreation" Version="20.0.1" />
    <!-- The MSBuild packages Joinery.Dovetail.Sdk.Tests compiles against (MSBuild.ProjectCreation brings Microsoft.Build); keep all three on one version. -->
    <PackageVersion Include="Microsoft.Build" Version="18.12.2" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.12.2" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.12.2" />
    <PackageVersion Include="MSBuild.StructuredLogger.Utils" Version="2.3.269" />
    <PackageVersion Include="NuGet.Packaging" Version="8.0.0" />
    <!-- NuGet.Packaging pulls the vulnerable 8.0.1 (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx) into Joinery.Dovetail.Sdk.Tests. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <!-- Sample.Uno pulls 10.0.12 of Pkcs and Xml through Uno (GHSA-7hqp-7c5m-4vq6 and others, fixed in 10.0.13). -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="11.0.0" />
    <PackageVersion Include="Rocket.Surgery.ModularPipelines.Extensions" Version="0.2.5" />
    <!-- The build host (build/Build.cs) references the published Dovetail and Specular generators directly, as Rocket.Surgery.ModularPipelines.Extensions requires; they write ConfigureDovetail and the module scan into it. -->
    <PackageVersion Include="Joinery.Dovetail.ModularPipelines" Version="0.7.1" />
    <PackageVersion Include="Sourcy.DotNet" Version="1.1.1" />
    <PackageVersion Include="Sourcy.Git" Version="1.1.1" />
    <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
    <PackageVersion Include="Aspire.Hosting" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="17.0.0" />
    <!-- The Functions SDK Joinery.Dovetail.Sdk.Azure.Functions chains (an MSBuild SDK, not a package reference). Pinned here for the SDK's generated Packages.props. -->
    <PackageVersion Include="Azure.Functions.Sdk" Version="1.1.0" />
    <!-- The isolated worker: FunctionsApplicationBuilder, the host Joinery.Dovetail.Hosting configures (Joinery.Dovetail.Hosting.AzureFunctions.Tests). -->
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <!-- Joinery.Dovetail.ModularPipelines; ModularPipelines 4 targets net11.0 only. -->
    <PackageVersion Include="ModularPipelines" Version="4.0.0" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="Polyfill" Version="11.4.5" />
    <PackageVersion Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
    <PackageVersion Include="BenchMarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Tomlyn.Extensions.Configuration" Version="2.0.1" />
    <!--
        Configuration binding and schemas. Dovetail doesn't depend on it (applications add it themselves); the samples and tests do, and
        Joinery.Dovetail.Sdk.Tests builds against this version.
    -->
    <PackageVersion Include="Optionary" Version="0.1.2" />
    <PackageVersion Include="bunit.web" Version="1.40.0" />
    <PackageVersion Include="DryIoc.Microsoft.DependencyInjection" Version="8.0.0" />
    <PackageVersion Include="Stashbox.Extensions.DependencyInjection" Version="6.0.0" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="OpenTelemetry" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="ZeroAlloc.Mediator" Version="6.7.2" />
    <PackageVersion Include="ZeroAlloc.Mediator.Cache" Version="6.7.2" />
    <PackageVersion Include="ZeroAlloc.Mediator.Generator" Version="6.7.2" />
    <PackageVersion Include="ZeroAlloc.Mediator.Validation" Version="6.7.2" />
    <PackageVersion Include="ZeroAlloc.Validation" Version="2.6.1" />
    <PackageVersion Include="ZeroAlloc.Validation.AspNetCore" Version="2.6.1" />
    <PackageVersion Include="ZeroAlloc.Validation.Inject" Version="2.6.1" />
    <PackageVersion Include="System.Interactive" Version="7.0.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Features" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.12.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- Pinned to the last version without a System.Text.Json dependency (2.x+ requires >=10.0.2, which
             conflicts with the pinned System.Text.Json used by the older Roslyn-host support projects). -->


    <!-- The build host (build/Build.cs) references it for its module scan; the Joinery.Dovetail.Sdk.Tests scaffolds reference it to prove Dovetail seeds Specular's provider without depending on Specular. -->
    <PackageVersion Include="Specular" Version="0.4.1" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.65.1" />
    <PackageVersion Include="Rocket.Surgery.Extensions.Testing.SourceGenerators" Version="11.0.1" />
    <PackageVersion Include="TUnit" Version="1.87.12" />
    <PackageVersion Include="TUnit.Mocks" Version="1.87.12" />
    <PackageVersion Include="TUnit.Assertions.Should" Version="1.85.0-beta" />
    <PackageVersion Include="Verify.TUnit" Version="33.7.1" />
    <PackageVersion Include="Verify.AngleSharp" Version="5.1.2" />
    <PackageVersion Include="Verify.Playwright" Version="3.3.0" />
    <PackageVersion Include="Verify.SourceGenerators" Version="2.5.0" />
    <!-- Validates Joinery.Dovetail.Serilog's configuration schema fragment against the draft-07 meta-schema in its tests (Apache-2.0). -->
    <PackageVersion Include="Corvus.Json.JsonSchema.Draft7" Version="5.8.12" />
    <!-- The command line framework Joinery.Dovetail.Sdk.Console adds to a console application (MIT). Pinned here for the SDK's generated Packages.props. -->
    <PackageVersion Include="ConsoleAppFramework" Version="5.8.1" />
  </ItemGroup>
  <!--
      Uno.Extensions 8.x serves both the net10.0 heads (Sample.Uno, on Uno.Sdk 7) and the net11.0 ones (Sample.Uno.Net11).
  -->
  <ItemGroup Label="Uno.Extensions">
    <PackageVersion Include="Uno.Extensions.Hosting.WinUI" Version="8.0.1" />
    <PackageVersion Include="Uno.Extensions.Navigation.WinUI" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.130" />
    <PackageVersion Include="Microsoft.Maui.Core" Version="10.0.130" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
    <!-- 11.x needs Microsoft.Extensions.Logging 11 on every target framework, so net10.0 stays on 10.x. -->
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
    <PackageVersion Include="Microsoft.Maui.Controls" Version="11.0.10" />
    <PackageVersion Include="Microsoft.Maui.Core" Version="11.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Gateway" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.FileExtensions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Configuration" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="11.0.0" />
  </ItemGroup>
</Project>
