<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="Rocket.Surgery.MSBuild.CI" Version="1.3.0-beta.2" />
    <GlobalPackageReference Include="Rocket.Surgery.MSBuild.GlobalAnalyzerConfig" Version="1.3.0-beta.2" />
    <GlobalPackageReference Include="Rocket.Surgery.MSBuild.GitVersion" Version="1.3.0-beta.2" />
    <GlobalPackageReference Include="Rocket.Surgery.MSBuild.SourceLink" Version="1.3.0-beta.2" />
    <PackageVersion Include="Rocket.Surgery.MyAssembly" Version="1.3.0-beta.2" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100-rc.3.26522.148" />
    <GlobalPackageReference Include="Microsoft.DotNet.ApiCompat.Task" Version="11.0.100-rc.3.26522.148" />
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.CodeFixes" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.Refactorings" Version="5.0.1" />
    <GlobalPackageReference Include="Spectre.Console.Analyzer" Version="1.0.0" />
    <GlobalPackageReference Include="FakeItEasy.Analyzer.CSharp" Version="6.1.1" />
    <GlobalPackageReference Include="JetBrains.ExternalAnnotations" Version="10.2.172" />
    <PackageVersion Include="Tomlyn.Extensions.Configuration" Version="2.0.1" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="FoggyBalrog.MermaidDotNet" Version="0.20.0" />
    <PackageVersion Include="MSBuild.ProjectCreation" Version="20.0.0" />
    <!-- The MSBuild packages Joinery.Dovetail.Sdk.Tests compiles against (MSBuild.ProjectCreation brings Microsoft.Build); keep all three on one version. -->
    <PackageVersion Include="Microsoft.Build" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.11.0" />
    <PackageVersion Include="MSBuild.StructuredLogger.Utils" Version="2.3.269" />
    <PackageVersion Include="NuGet.Packaging" Version="7.9.0" />
    <!-- NuGet.Packaging pulls the vulnerable 8.0.1 (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx) into Joinery.Dovetail.Sdk.Tests. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- Sample.Uno pulls 10.0.12 of Pkcs and Xml through Uno (GHSA-7hqp-7c5m-4vq6 and others, fixed in 10.0.13). -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.14" />
    <PackageVersion Include="Rocket.Surgery.ModularPipelines.Extensions" Version="0.1.15" />
    <PackageVersion Include="Sourcy.DotNet" Version="1.1.1" />
    <PackageVersion Include="Sourcy.Git" Version="1.1.1" />
    <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
    <PackageVersion Include="JetBrains.Annotations.Sources" Version="2026.2.0" />
    <PackageVersion Include="Aspire.Hosting" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.4" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="Polyfill" Version="11.4.5" />
    <PackageVersion Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
    <PackageVersion Include="BenchMarkDotNet" Version="0.15.8" />
    <PackageVersion Include="bunit.web" Version="1.40.0" />
    <PackageVersion Include="DryIoc.Microsoft.DependencyInjection" Version="8.0.0-preview-04" />
    <PackageVersion Include="Stashbox.Extensions.DependencyInjection" Version="6.0.0" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="OpenTelemetry" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="System.Interactive" Version="7.0.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Features" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.9.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- Pinned to the last version without a System.Text.Json dependency (2.x+ requires >=10.0.2, which
             conflicts with the pinned System.Text.Json used by the older Roslyn-host support projects). -->
    
    
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="FakeItEasy" Version="9.0.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="Rocket.Surgery.Extensions.Testing.FakeItEasy" Version="11.0.1" />
    <PackageVersion Include="Rocket.Surgery.Extensions.Testing.TUnit" Version="11.0.1" />
    <PackageVersion Include="Rocket.Surgery.Extensions.Testing.SourceGenerators" Version="11.0.1" />
    <PackageVersion Include="TUnit" Version="1.76.45" />
    <PackageVersion Include="Verify.TUnit" Version="33.3.4" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CrashDump" Version="2.5.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.2" />
    <PackageVersion Include="Verify.AngleSharp" Version="5.1.2" />
    <PackageVersion Include="Verify.Playwright" Version="3.2.0" />
    <PackageVersion Include="Verify.SourceGenerators" Version="2.5.0" />
    <!-- Validates Joinery.Dovetail.Build.Tasks' schemas against the draft-07 meta-schema in its tests (Apache-2.0). -->
    <PackageVersion Include="Corvus.Json.JsonSchema.Draft7" Version="5.7.9" />
  </ItemGroup>
  <!--
      The pinned MSBuild task references sit in their own file so Renovate can leave just that group alone
      (.github/renovate.json) while the same packages elsewhere keep updating.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Packages.MSBuildTasks.props" />
  <!--
      Uno.Extensions per release line: no stable 7.x has net10.0+ assets (its net9.0 ones serve net10.0), and only the 8.0
      prereleases target net10.0+, so net11.0 builds take those until 8.0 is stable. Kept apart from the per-framework groups
      below so the two lines can be bumped independently.
  -->
  <ItemGroup Label="Uno.Extensions 7.x" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
    <PackageVersion Include="Uno.Extensions.Hosting.WinUI" Version="7.3.6" />
    <PackageVersion Include="Uno.Extensions.Navigation.WinUI" Version="7.3.6" />
  </ItemGroup>
  <ItemGroup Label="Uno.Extensions 8.x" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
    <PackageVersion Include="Uno.Extensions.Hosting.WinUI" Version="8.0.0-dev.150" />
    <PackageVersion Include="Uno.Extensions.Navigation.WinUI" Version="8.0.0-dev.150" />
  </ItemGroup>
  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.120" />
    <PackageVersion Include="Microsoft.Maui.Core" Version="10.0.120" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
    <PackageVersion Include="Microsoft.Maui.Controls" Version="11.0.0-rc.2.26505.5" />
    <PackageVersion Include="Microsoft.Maui.Core" Version="11.0.0-rc.2.26505.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Gateway" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.FileExtensions" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Configuration" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0-rc.3.26522.148" />
  </ItemGroup>
</Project>
